/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests (Drop-seq)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same light dataset as -profile test, in Drop-seq format (XC/XM tags, dense DGE).

    Use as follows:
        nextflow run nf-core/scalpel -profile test_dropseq,<conda/docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

includeConfig 'test.config'

params {
    config_profile_name        = 'test_dropseq'
    config_profile_description = 'Minimal Drop-seq test dataset to check pipeline function'

    sequencing_platform = 'dropseq'
    samplesheet         = "${projectDir}/tests/data/light_dropseq/samplesheet.csv"
}

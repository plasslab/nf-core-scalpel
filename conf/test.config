/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/scalpel -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 7,
        memory: '11.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'test'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data (light dataset: GSE104556 chr17:14-16Mb, see tests/data/make_test_data.sh)
    samplesheet   = "${projectDir}/tests/data/light/samplesheet.csv"
    gtf           = "${projectDir}/tests/data/light/annotations/genes.gtf.gz"
    transcriptome = "${projectDir}/tests/data/light/annotations/transcripts.fa.gz"
    ip_reference  = "${projectDir}/tests/data/light/annotations/polya.track.gz"
}

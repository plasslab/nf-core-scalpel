/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // Salmon settings of the original SCALPEL (plasslab/SCALPEL)
    withName: 'SALMON_INDEX' {
        label = 'process_high'
        ext.args = '--gencode'
    }

    withName: 'SALMON_QUANT' {
        label = 'process_high'
        ext.args = '--minScoreFraction 0.7 --vbPrior 5 --perNucleotidePrior'
    }

    withName: 'SEQNAMES_CHECK|IP_SPLITTING|SAMTOOLS_INDEX|DGE_BARCODES' {
        publishDir = [ enabled: false ]
    }

    withName: 'IP_REFERENCE_GENERATION' {
        publishDir = [
            path: { "${params.outdir}/ip_reference" },
            mode: params.publish_dir_mode,
            pattern: 'ip_reference.track.gz'
        ]
    }

    withName: 'BED_CONVERSION' {
        publishDir = [
            path: { "${params.outdir}/bed/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTERED_BAMS' {
        publishDir = [
            path: { "${params.outdir}/filtered_bams" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'READS_MAPPING_AND_FILTERING' {
        label = 'process_medium'
        maxForks = 15
    }

    withName: 'IP_FILTERING' {
        label = 'process_low'
        maxForks = 15
    }

    withName: 'PROBABILITY_DISTRIBUTION' {
        label = 'process_low'
    }

    withName: 'FRAGMENT_PROBABILITY' {
        label = 'process_low'
    }

}
